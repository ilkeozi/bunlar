{
  "name": "opencascade-convert",
  "projectType": "library",
  "root": "packages/opencascade-convert",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "packages/opencascade-convert"
      }
    },
    "convert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register src/cli.ts {args}",
        "cwd": "packages/opencascade-convert"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest -c packages/opencascade-convert/vitest.config.ts",
        "cwd": "."
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest -c packages/opencascade-convert/vitest.integration.config.ts",
        "cwd": "."
      }
    }
  }
}
