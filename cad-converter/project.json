{
  "name": "cad-converter",
  "projectType": "application",
  "root": "cad-converter",
  "sourceRoot": "cad-converter",
  "targets": {
    "convert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash cad-converter/scripts/docker_convert.sh"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t bunlar-cad-converter -f cad-converter/Dockerfile ."
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash cad-converter/scripts/smoke_test.sh"
      }
    }
  },
  "tags": []
}
